# --- Secrets & Environment ---
# Critical: Never commit your passwords
.env
.env.local
.env.*.local

# --- Docker ---
# Ignore the actual database files if you map them to a local folder
# (Though we used a named volume 'postgres_data', this is good practice)
postgres_data/
pgadmin_data/

# --- Go (Golang) ---
# Binaries and architectures
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test coverage files
*.out
*.test
*.prof

# Dependency directories (only if using vendoring)
vendor/

# go.work makes the build workspace-dependent, and there is a single module at
# the repository root, so nothing here needs one.
go.work
go.work.sum

tmp

# The local runtime configuration, which holds the JWT secret. Anchored to the
# repository root on purpose: an unanchored "config.yaml" also matched
# docker/config.yaml, the baseline the Dockerfile copies into the image, which
# left it untracked and broke the image build from a fresh clone.
/config.yaml

# Vite build output, embedded by server/pkg/modules/web via go:embed. Only the
# .gitkeep placeholder is tracked so the package compiles on a fresh clone,
# before the first UI build. Vite recreates it every build by copying
# web/public/.gitkeep into the output directory.
/server/pkg/modules/web/dist/*
!/server/pkg/modules/web/dist/.gitkeep

# GoReleaser's output. Anchored to the root so it cannot match the Vite output
# above, which is a different directory that happens to share the name.
/dist

data
backups

# TLS certificate and private key the server is pointed at
certs

# --- Local tooling ---
# Editor and AI assistant configuration, personal to whoever is working on the
# checkout and not part of the project.
.crush.json
.claude
.idea
.vscode
**/.agents
**/.mcp.json
**/skills-lock.json
